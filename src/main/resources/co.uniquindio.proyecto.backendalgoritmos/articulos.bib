  author = {Brian Litt},
  title = {Single neuron computation: T. McKenna, J. Davis and S.F. Zornetzer (Eds.) (Academic Press, San Diego, CA, 1992, 664 p., Price US $59.95)},
  year = {1993},
  numpages = {},
  abstract = {}
