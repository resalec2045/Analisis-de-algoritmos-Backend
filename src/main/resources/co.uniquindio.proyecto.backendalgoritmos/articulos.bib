@article{
  author = {Zhuotao Lu and Ming M. Chiu and Yunhuo Cui and Weijie Mao and Hao Lei},
  title = {Effects of Game-Based Learning on Students’ Computational Thinking: A Meta-Analysis},
  year = {2022},
  numpages = {},
  abstract = {This meta-analysis determined game-based learning’s (GBL) overall effect on students’ computational thinking (CT) and tested for moderators, using 28 effect sizes from 24 studies of 2,134 participants. The random effects model results showed that GBL had ...}
