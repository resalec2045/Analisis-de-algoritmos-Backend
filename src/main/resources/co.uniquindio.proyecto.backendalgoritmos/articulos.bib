@article{
  author = {Yue Zeng and Weipeng Yang and Alfredo Bautista},
  title = {Developing young children&#x2019;s computational thinking through programming with a hybrid kit / Desarrollo del pensamiento computacional infantil a trav&#xe9;s de la programaci&#xf3;n con un kit h&#xed;brido},
  year = {2024},
  abstract = {Fostering young children’s computational thinking (CT) has garnered global interest as it aligns with the cultivation of twenty-first-century skills. Previous studies have focused on physical, virtual and hybrid kits with virtual programming blocks, but ...}
}
