@article{KOORAEIM20122796,
title = {Investigation on EEG Pattern Differences in Males and Females During Convergent and Divergent Thinking},
journal = {Procedia - Social and Behavioral Sciences},
volume = {46},
pages = {2796-2800},
year = {2012},
note = {4th WORLD CONFERENCE ON EDUCATIONAL SCIENCES (WCES-2012) 02-05 February 2012 Barcelona, Spain},
issn = {1877-0428},
doi = {https://doi.org/10.1016/j.sbspro.2012.05.566},
