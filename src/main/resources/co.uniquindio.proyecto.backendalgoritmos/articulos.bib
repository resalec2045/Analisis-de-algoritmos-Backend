@incollection{VALLERO2024613,
title = {Chapter 20 - Future},
editor = {Daniel A. Vallero and Trevor M. Letcher},
booktitle = {Unraveling Environmental Disasters (Second Edition)},
publisher = {Elsevier},
edition = {Second Edition},
pages = {613-634},
year = {2024},
isbn = {978-0-443-18651-6},
