  author = {Samantha Shorey and Benjamin Mako Hill and Samuel Woolley},
  title = {From hanging out to figuring it out: Socializing online as a pathway to computational thinking},
  year = {2020},
  abstract = {Although socializing is a powerful driver of youth engagement online, platforms struggle to leverage social engagement to promote learning. We seek to understand this dynamic using a multi-stage analysis of over 14,000 comments on Scratch, an online ...}
